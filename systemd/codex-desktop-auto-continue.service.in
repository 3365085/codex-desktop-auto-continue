[Unit]
Description=Resume Goals and queue ordinary Codex failures without UI switching
After=graphical-session.target

[Service]
Type=simple
ExecStart=@PYTHON@ @WATCHER@ --codex-bin @CODEX_BIN@ --max-attempts 10000 --goal-desktop-ui
Restart=on-failure
RestartSec=1
UMask=0077

[Install]
WantedBy=default.target
