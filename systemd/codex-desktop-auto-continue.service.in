[Unit]
Description=Click Codex Desktop retry and Goal-resume buttons after transient failures
After=graphical-session.target

[Service]
Type=simple
ExecStart=@PYTHON@ @WATCHER@ --codex-bin @CODEX_BIN@ --max-attempts 10000
Restart=on-failure
RestartSec=1
UMask=0077

[Install]
WantedBy=default.target
